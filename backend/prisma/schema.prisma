// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ENUMS

enum UserRole {
  USER
  ADMIN
}

enum ApplicationType {
  CHATBOT
  CODE_ASSISTANT
  AI_AGENT
  API
  OTHER
}

enum ApplicationEnvironment {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum ApplicationStatus {
  ACTIVE
  INACTIVE
}

// Conversation
enum ConversationStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

// Message
enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

// Event
enum EventType {
  LLM_REQUEST
  LLM_RESPONSE

  // Future event types
  TOOL_CALL
  TOOL_RESPONSE
  AGENT_ACTION

  EVALUATION_STARTED
  EVALUATION_COMPLETED

  POLICY_VIOLATION
  SAFETY_VIOLATION
  HIGH_RISK_DETECTED
}

//EVALUATION
enum EvaluationStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum EvaluationDecision {
  PASS
  REVIEW
  REJECT
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum JudgeType {
  QUALITY
  SAFETY
  TRUST
}

enum JudgeExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

//USER 
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshToken String?

  // Relationships
  applications Application[]

  @@map("users")
}

//APPLICATION
model Application {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  name        String
  description String?

  type        ApplicationType
  environment ApplicationEnvironment @default(DEVELOPMENT)
  status      ApplicationStatus      @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  apiKeys       ApiKey[]
  conversations Conversation[]
  events        Event[]
  evaluations   Evaluation[]

  @@index([userId])
  @@map("applications")
}

//API KEY

model ApiKey {
  id            String @id @default(uuid()) @db.Uuid
  applicationId String @db.Uuid

  name      String
  keyPrefix String
  keyHash   String

  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([keyPrefix])
  @@map("api_keys")
}

// CONVERSATION

model Conversation {
  id String @id @default(uuid()) @db.Uuid

  applicationId String @db.Uuid

  // ID provided by the external AI application
  externalId String

  title String?

  status ConversationStatus @default(ACTIVE)

  // Flexible conversation-level metadata
  metadata Json?

  startedAt DateTime @default(now())

  lastMessageAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // RELATIONSHIPS
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  messages Message[]

  events Event[]

  // CONSTRAINTS

  // INDEXES
  evaluations Evaluation[]

  // Same external conversation cannot exist twice
  // within the same application.
  //
  // Application A + chat_123  -> Allowed
  // Application B + chat_123  -> Allowed
  // Application A + chat_123  -> Duplicate
  //
  @@unique([applicationId, externalId])
  @@index([applicationId])
  @@index([status])
  @@index([lastMessageAt])
  @@map("conversations")
}

// MESSAGE

model Message {
  id String @id @default(uuid()) @db.Uuid

  conversationId String @db.Uuid

  // Message sender/type
  role MessageRole

  // Actual message content
  content String

  // Deterministic ordering inside conversation
  sequence Int

  // Flexible message-level metadata
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // RELATIONSHIPS

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // CONSTRAINTS

  // INDEXES

  // Prevent two messages from having
  // the same sequence number in one conversation.
  @@unique([conversationId, sequence])
  @@index([conversationId])
  @@index([conversationId, role])
  @@index([createdAt])
  @@map("messages")
}

// EVENT

model Event {
  id String @id @default(uuid()) @db.Uuid

  // Every event belongs directly to an application
  applicationId String @db.Uuid

  // Optional because some application events
  // may not belong to a specific conversation.
  conversationId String? @db.Uuid

  // ID provided by the external AI application.
  //
  // Used for idempotency / duplicate detection.
  externalEventId String

  type EventType

  // Complete event payload
  payload Json

  // Additional flexible metadata
  metadata Json?

  // When event actually occurred in external system
  occurredAt DateTime

  // When event was received/stored by AI Sentinel
  createdAt DateTime @default(now())

  // RELATIONSHIPS

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // CONSTRAINTS

  // INDEXES
  evaluations Evaluation[]

  // Prevent duplicate external events
  // inside the same application.
  //
  // Application A + event_123 -> Allowed
  // Application B + event_123 -> Allowed
  // Application A + event_123 -> Duplicate
  //
  @@unique([applicationId, externalEventId])
  @@index([applicationId])
  @@index([conversationId])
  @@index([applicationId, type])
  @@index([occurredAt])
  @@map("events")
}

//Evaluation

model Evaluation {
  id String @id @default(uuid()) @db.Uuid

  applicationId  String  @db.Uuid
  conversationId String  @db.Uuid
  eventId        String? @db.Uuid

  status EvaluationStatus @default(PENDING)

  overallScore Float?
  riskLevel    RiskLevel?
  decision     EvaluationDecision?
  summary      String?

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  judgeExecutions JudgeExecution[]

  @@index([applicationId])
  @@index([conversationId])
  @@index([status])
  @@index([createdAt])
  @@map("evaluations")
}

model JudgeExecution {
  id String @id @default(uuid()) @db.Uuid

  evaluationId String @db.Uuid

  judgeType JudgeType
  status    JudgeExecutionStatus @default(PENDING)

  score     Float?
  riskLevel RiskLevel?

  result    Json?
  reasoning String?

  model    String?
  provider String?

  latencyMs Int?

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([evaluationId])
  @@index([judgeType])
  @@index([status])
  @@map("judge_executions")
}
